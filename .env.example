# 環境変数のひな形。コピーして .env を作り、値を書き換える（.env は Git に含めない）
#   開発:  cp .env.example .env    （そのまま使える）
#   本番:  cp .env.example .env && chmod 600 .env  （「本番では必ず変更」の項目を書き換える）

# --- DB ---
# 開発: docker-compose.dev.yml のDB / 本番: postgresql://artleave:<POSTGRES_PASSWORD>@db:5432/artleave
DATABASE_URL="postgresql://artleave:artleave@localhost:5432/artleave"
# 本番では必ず変更（openssl rand -base64 24）。本番の docker-compose.yml の DB が使う
POSTGRES_PASSWORD="artleave"

# --- 認証（Auth.js）---
# 本番では必ず変更（openssl rand -base64 32）
AUTH_SECRET="dev-only-secret-change-me-0123456789abcdef"
# 開発: http://localhost:3000 / 本番: https://<ドメイン>
AUTH_URL="http://localhost:3000"

# --- 画像の保存先 ---
UPLOAD_DIR="./.uploads"

# --- 本番のみ ---
# 公開するドメイン（Caddy と DDNS が使う）
DOMAIN="artleave.example.com"
# Cloudflare の API トークン（Zone.DNS 編集権限）
CLOUDFLARE_API_TOKEN=""

# --- パスワード再設定メール（未実装・Phase 1 で使用）---
SMTP_HOST=""
SMTP_USER=""
SMTP_PASS=""

# --- 将来（F-16 AIチェック）---
# 支払い情報を登録していないプロジェクトのキーを使う
GEMINI_API_KEY=""
